# Windows shells are picky about line endings: cmd.exe can misparse labels and `goto`
# in an LF-terminated batch file, so force CRLF for everything Windows executes and
# keep LF for the Python sources.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.py  text eol=lf
*.ico binary
